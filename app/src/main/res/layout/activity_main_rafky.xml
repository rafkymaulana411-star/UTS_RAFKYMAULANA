<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true"
    tools:context=".MainActivityRafky">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/primary_blue"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle_main_menu"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="UTS Pemrograman Mobile"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nama: Rafky Maulana"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="italic" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/title_main_menu"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Menu Button 1: Info Gaji Karyawan -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInfoGaji"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:text="@string/menu_info_gaji"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- Menu Button 2: Petunjuk Penggunaan -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPetunjuk"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:text="@string/menu_petunjuk"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_help"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- Menu Button 3: Tentang Aplikasi -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTentang"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:text="@string/menu_tentang"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_info_details"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- Menu Button 4: Exit -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_exit"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/danger_red"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_close_clear_cancel"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

    </LinearLayout>

</ScrollView>
