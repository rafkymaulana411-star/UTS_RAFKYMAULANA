<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true"
    tools:context=".HasilGajiActivityRafky">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/title_hasil_gaji"
            android:textColor="@color/primary_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Card Results -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- NIK -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_nik"
                        android:textColor="@color/text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHasilNik"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="123456" />

                </LinearLayout>

                <!-- Nama -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_nama"
                        android:textColor="@color/text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHasilNama"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Budi Santoso" />

                </LinearLayout>

                <!-- Gaji Pokok -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_gaji_pokok"
                        android:textColor="@color/text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHasilGajiPokok"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        tools:text="Rp 5.000.000" />

                </LinearLayout>

                <!-- Tunjangan Jabatan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_tunjangan_jabatan"
                        android:textColor="@color/text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHasilTunjanganJabatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        tools:text="Rp 1.000.000" />

                </LinearLayout>

                <!-- Hari Kerja -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_hari_kerja"
                        android:textColor="@color/text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHasilHariKerja"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        tools:text="22 Hari" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="#E0E0E0" />

                <!-- Tunjangan Makan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_tunjangan_makan"
                        android:textColor="@color/text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHasilTunjanganMakan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        tools:text="Rp 220.000" />

                </LinearLayout>

                <!-- Tunjangan Transport -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_tunjangan_transport"
                        android:textColor="@color/text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHasilTunjanganTransport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        tools:text="Rp 110.000" />

                </LinearLayout>

                <!-- Gaji Kotor -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_gaji_kotor"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHasilGajiKotor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Rp 6.330.000" />

                </LinearLayout>

                <!-- Pajak -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_pajak"
                        android:textColor="@color/danger_red"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHasilPajak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/danger_red"
                        android:textSize="15sp"
                        tools:text="Rp 633.000" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="#E0E0E0" />

                <!-- Gaji Bersih -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_gaji_bersih"
                        android:textColor="@color/success_green"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHasilGajiBersih"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/success_green"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Rp 5.697.000" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKembaliGaji"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Hitung Gaji Lagi / Kembali"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="8dp" />

    </LinearLayout>

</ScrollView>
