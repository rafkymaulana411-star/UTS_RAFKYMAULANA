<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true"
    tools:context=".PetunjukActivityRafky">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/title_petunjuk"
            android:textColor="@color/primary_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Berikut adalah petunjuk penggunaan Aplikasi Perhitungan Gaji Karyawan:"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="1. Buka menu Info Gaji Karyawan dari Halaman Menu Utama."
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="2. Isilah semua formulir data karyawan meliputi NIK, Nama Karyawan, Gaji Pokok, Tunjangan Jabatan, dan Jumlah Hari Kerja."
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="3. Tekan tombol 'Hitung Gaji' untuk memproses perhitungan."
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="4. Rumus Perhitungan Gaji:\n  • Tunjangan Makan = Jumlah Hari Kerja × Rp 10.000\n  • Tunjangan Transportasi = Jumlah Hari Kerja × Rp 5.000\n  • Gaji Kotor = Gaji Pokok + Tunjangan Jabatan + Tunjangan Makan + Tunjangan Transportasi\n  • Pajak = 10% × Gaji Kotor\n  • Gaji Bersih = Gaji Kotor - Pajak"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="5. Hasil rincian gaji akan ditampilkan pada halaman Hasil Perhitungan."
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="6. Gunakan tombol 'Reset' jika ingin mengosongkan form input."
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKembali"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/btn_kembali"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="8dp" />

    </LinearLayout>

</ScrollView>
